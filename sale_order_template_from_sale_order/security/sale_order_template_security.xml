<odoo>
    <!--
        group_sale_manager implies group_sale_salesman, and group rules for
        one mode are OR-ed. The manager rules restore full access.
        Read stays unrestricted so any template can still be applied.
        Header rules are write-only: a new template's creator is the current
        user. Line and option rules also apply to create, because _create
        checks the inserted rows.
    -->
    <record id="sale_order_template_rule_sale_salesman" model="ir.rule">
        <field name="name">Quotation templates: salesman writes own templates</field>
        <field name="model_id" ref="sale_management.model_sale_order_template" />
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]" />
        <field name="perm_read" eval="False" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>
    <record id="sale_order_template_rule_sale_manager" model="ir.rule">
        <field name="name">Quotation templates: manager writes every template</field>
        <field name="model_id" ref="sale_management.model_sale_order_template" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]" />
        <field name="perm_read" eval="False" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>
    <record id="sale_order_template_line_rule_sale_salesman" model="ir.rule">
        <field
            name="name"
        >Quotation template lines: salesman writes own templates</field>
        <field name="model_id" ref="sale_management.model_sale_order_template_line" />
        <field
            name="domain_force"
        >[('sale_order_template_id.create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]" />
        <field name="perm_read" eval="False" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="False" />
    </record>
    <record id="sale_order_template_line_rule_sale_manager" model="ir.rule">
        <field
            name="name"
        >Quotation template lines: manager writes every template</field>
        <field name="model_id" ref="sale_management.model_sale_order_template_line" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]" />
        <field name="perm_read" eval="False" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="False" />
    </record>
    <record id="sale_order_template_option_rule_sale_salesman" model="ir.rule">
        <field
            name="name"
        >Quotation template options: salesman writes own templates</field>
        <field name="model_id" ref="sale_management.model_sale_order_template_option" />
        <field
            name="domain_force"
        >[('sale_order_template_id.create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]" />
        <field name="perm_read" eval="False" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="False" />
    </record>
    <record id="sale_order_template_option_rule_sale_manager" model="ir.rule">
        <field
            name="name"
        >Quotation template options: manager writes every template</field>
        <field name="model_id" ref="sale_management.model_sale_order_template_option" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]" />
        <field name="perm_read" eval="False" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="False" />
    </record>
</odoo>
