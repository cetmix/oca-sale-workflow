<odoo>
    <record id="sale_order_view_form_discount_type" model="ir.ui.view">
        <field name="name">sale.order.form.discount.type</field>
        <field name="model">sale.order</field>
        <field
            name="inherit_id"
            ref="sale_order_general_discount.sale_order_general_discount_form_view"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='general_discount']" position="before">
                <field name="general_discount_type" />
            </xpath>

            <xpath expr="//field[@name='general_discount']" position="after">
                <xpath expr="//field[@name='general_discount_fixed']" position="move" />
            </xpath>

            <xpath expr="//field[@name='general_discount']" position="attributes">
                <attribute
                    name="attrs"
                >{'invisible': [('general_discount_type', '=', 'fixed')]}</attribute>
            </xpath>

            <xpath expr="//field[@name='general_discount_fixed']" position="attributes">
                <attribute
                    name="attrs"
                >{'invisible': [('general_discount_type', '=', 'percent')]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
